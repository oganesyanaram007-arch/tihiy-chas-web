<script>
// Скрипт Telegram грузится асинхронно: в обычном браузере telegram.org
// может быть недоступен, и блокирующий тег держал бы пустой экран до таймаута.
let tg = null, inRealTelegram = false;
async function waitTelegramSdk(ms){
  const t0 = Date.now();
  while(!(window.TG_SDK && window.TG_SDK.done) && Date.now() - t0 < ms){
    await new Promise(r => setTimeout(r, 40));
  }
}
function initTelegram(){
  tg = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;
// Тот же признак, что и в мини-аппе гостя: непустая initData бывает только
// при реальном запуске внутри клиента Telegram — там уже есть своя верхняя
// панель, и наша декоративная имитация становится лишним дублем.
// initData Telegram передаёт не всегда — зависит от способа открытия.
// Проверяем несколько признаков, любой означает, что мы внутри клиента.
  inRealTelegram = !!(tg && (
    (tg.initData && tg.initData.length > 0) ||
    (tg.initDataUnsafe && tg.initDataUnsafe.user) ||
    (tg.platform && tg.platform !== "unknown") ||
    tg.isExpanded !== undefined
  ));
  if(inRealTelegram){
    document.querySelectorAll('.statusbar, .tgbar').forEach(el => el.style.display = 'none');
  }
  if(tg){try{tg.ready();tg.expand();tg.setHeaderColor('#191410');tg.setBackgroundColor('#F4EFE6');}catch(e){}}
}
function hap(){if(tg&&tg.HapticFeedback){try{tg.HapticFeedback.impactOccurred('light')}catch(e){}}}
const $=id=>document.getElementById(id);

/* Адрес нашего API. Пусто — работает демо-режим с локальной имитацией,
   чтобы мастер можно было полностью посмотреть уже сейчас, без сервера.
   После деплоя бэкенда впишите сюда https://api.вашдомен */
const API_URL = "";
/* Боевой режим. API живёт на том же домене, поэтому адрес относительный —
   ни лишнего DNS-резолва, ни CORS. DEMO_MODE остаётся только для показа
   мастера без сервера. */
const DEMO_MODE = false;

const DISTRICTS=[
 ["petro","Петроградский"],["centr","Центральный"],["adm","Адмиралтейский"],
 ["vasil","Василеостровский"],["mosk","Московский"],["nev","Невский"],["primor","Приморский"],
 ["vyb","Выборгский"],["kalin","Калининский"],["kirov","Кировский"],["frunz","Фрунзенский"],
 ["krasnog","Красногвардейский"],["krasnos","Красносельский"],["push","Пушкинский"]
];
const DN=Object.fromEntries(DISTRICTS);
const CAT_LABEL={food:"Ресторан / кафе",coffee:"Кофейня",beauty:"Красота",spa:"СПА и здоровье",fun:"Досуг",auto:"Авто"};
const WDS=["Пн","Вт","Ср","Чт","Пт","Сб","Вс"];
const STATUS_LABEL={draft:"Черновик",moderation:"На модерации",active:"Опубликовано"};

/* ---------- демо-хранилище (используется, если API_URL пуст) ---------- */
const DEMO = { venues: [], nextId: 1 };

async function api(path, opts={}){
  if(DEMO_MODE) return demoApi(path, opts);
  const initData = (tg && tg.initData) || "";
  const r = await fetch(API_URL+path, {
    ...opts,
    credentials:"same-origin",
    headers:{"Content-Type":"application/json","X-Init-Data":initData, ...(opts.headers||{})}
  });
  const data = await r.json().catch(()=>({}));
  if(!r.ok) throw new Error(data.detail || "Ошибка сервера");
  return data;
}

/* Имитация бэкенда для локального просмотра мастера без сервера —
   тот же принцип, что и demo-режим формы на сайте. */
function demoApi(path, opts){
  const method=(opts.method||"GET").toUpperCase();
  const body = opts.body ? JSON.parse(opts.body) : {};
  return new Promise(res=>setTimeout(()=>{
    if(path==="/api/cab/venues" && method==="POST"){
      const id=DEMO.nextId++;
      DEMO.venues.push({id, ...body, photos:[], quiet_windows:[], status:"draft"});
      return res({ok:true, venue_id:id});
    }
    if(path==="/api/cab/venues" && method==="GET"){
      return res({venues:DEMO.venues.map(v=>({id:v.id,name:v.name,status:v.status,
        cat_label:CAT_LABEL[v.cat],district:v.district}))});
    }
    const m1=path.match(/^\/api\/cab\/venues\/(\d+)$/);
    if(m1 && method==="GET"){
      const v=DEMO.venues.find(x=>x.id==m1[1]);
      return res({...v, cat_label:CAT_LABEL[v.cat]});
    }
    if(m1 && method==="PATCH"){
      const v=DEMO.venues.find(x=>x.id==m1[1]); Object.assign(v,body);
      return res({ok:true});
    }
    const m2=path.match(/^\/api\/cab\/venues\/(\d+)\/photos$/);
    if(m2 && method==="POST"){
      const v=DEMO.venues.find(x=>x.id==m2[1]);
      v.photos.push(body.data_url);
      return res({ok:true, is_cover:v.photos.length===1});
    }
    const m3=path.match(/^\/api\/cab\/venues\/(\d+)\/quiet-hours$/);
    if(m3 && method==="PUT"){
      const v=DEMO.venues.find(x=>x.id==m3[1]);
      v.quiet_windows=[];
      body.weekdays.forEach(wd=>body.slots.forEach(sl=>v.quiet_windows.push({weekday:wd,...sl})));
      return res({ok:true, windows:v.quiet_windows.length});
    }
    const m4=path.match(/^\/api\/cab\/venues\/(\d+)\/submit$/);
    if(m4 && method==="POST"){
      const v=DEMO.venues.find(x=>x.id==m4[1]);
      v.status="moderation";
      setTimeout(()=>{v.status="active";},6000); // демо: авто-одобрение через 6 сек, чтобы показать статус целиком
      return res({ok:true, status:"moderation"});
    }
    res({ok:true});
  }, 350));
}

/* ---------- вход ---------- */
let ME=null;
async function boot(){
  await waitTelegramSdk(1800);
  initTelegram();
  const u = (tg && tg.initDataUnsafe) ? tg.initDataUnsafe.user : null;
  ME = {name: (u && u.first_name) || "Владелец", id: (u && u.id) || 0};
  $("gateStatus").textContent = "Проверяем доступ…";

  // Одноразовый код из ссылки бота меняем на сессию и сразу убираем из адреса,
  // чтобы он не остался ни в истории браузера, ни в пересланной ссылке.
  let keyError = "";
  const key = new URLSearchParams(location.search).get("k");
  if(key && !DEMO_MODE){
    try{
      await api("/api/cab/session", {method:"POST", body:JSON.stringify({code:key})});
    }catch(e){ keyError = (e && e.message) || ""; }
    try{ history.replaceState(null, "", location.pathname); }catch(e){}
  }

  try{
    await refreshList();
    $("listGreeting").textContent = `Здравствуйте, ${ME.name}!`;
    go("list");
  }catch(e){
    const msg = keyError || (e && e.message) || "";
    $("gateStatus").textContent = /[а-яА-Я]/.test(msg)
      ? msg + ". Новый вход — команда /cabinet в боте @Tihiy_chas_yourbot."
      : "Откройте кабинет через бота @Tihiy_chas_yourbot — команда /cabinet.";
  }
}

/* ---------- роутер ---------- */
const SCR={gate:"scr-gate",list:"scr-list",step1:"scr-step1",step2:"scr-step2",
          step3:"scr-step3",step4:"scr-step4",status:"scr-status"};
let screen="gate";
function go(s){
  screen=s;
  Object.values(SCR).forEach(id=>$(id).classList.remove("on"));
  $(SCR[s]).classList.add("on");
  $("app").scrollTop=0;
  $("tgLeft").textContent = s==="list" ? "Закрыть" : "‹ Назад";
  $("wzActions").style.display = ["step1","step2","step3","step4"].includes(s) ? "flex" : "none";
  $("tabbar").style.display = (s==="list") ? "flex" : "none";
  if(s==="step1"){$("wzNext").textContent="Далее";}
  if(s==="step4"){$("wzNext").innerHTML="Отправить на модерацию";}
  else if(s==="step2"||s==="step3"){$("wzNext").textContent="Далее";}
}
$("tgLeft").onclick=()=>{hap();
  if(["step1","step2","step3","step4"].includes(screen)) go("list");
  else if(screen==="status") go("list");
  else toast("В Telegram здесь закроется приложение");};
document.querySelectorAll(".tab").forEach(t=>t.onclick=()=>{hap();
  document.querySelectorAll(".tab").forEach(x=>x.classList.remove("sel"));t.classList.add("sel");
  if(t.dataset.t==="list") go("list"); else toast("Профиль владельца — скоро");});

/* ---------- список заведений ---------- */
async function refreshList(){
  const {venues} = await api("/api/cab/venues");
  const box=$("venueList"); box.innerHTML="";
  if(!venues.length){
    box.innerHTML=`<div style="margin:0 18px;padding:26px;text-align:center;color:var(--ink-soft);font-family:var(--disp);font-style:italic">Пока нет заведений — добавьте первое</div>`;
    return;
  }
  venues.forEach(v=>{
    const row=document.createElement("div");
    row.className="venue-row";
    row.innerHTML=`<div class="vi"><svg class="ic" style="width:19px;height:19px" viewBox="0 0 24 24"><use href="#ic-store"/></svg></div>
      <div><b>${v.name}</b><span>${v.cat_label} · ${DN[v.district]||v.district}</span></div>
      <span class="badge ${v.status}">${STATUS_LABEL[v.status]}</span>`;
    row.onclick=()=>openStatus(v.id);
    box.appendChild(row);
  });
}
$("addVenueBtn").onclick=()=>{hap();resetWizard();go("step1");};

/* ---------- мастер: состояние ---------- */
let W={id:null,name:"",cat:"food",district:"petro",address:"",phone:"",url:"",
      photos:[],uploaded:[],weekdays:[0,1,2,3,4],slots:[{hour:12,discount:30}]};

function resetWizard(){
  W={id:null,name:"",cat:"food",district:"petro",address:"",phone:"",url:"",
    photos:[],uploaded:[],weekdays:[0,1,2,3,4],slots:[{hour:12,discount:30}]};
  $("fName").value="";$("fAddr").value="";$("fPhone").value="";$("fUrl").value="";
  $("fCat").value="food";$("fDist").value="petro";
  renderPhotos();renderWeekdays();renderSlots();
}

(function initDistSelect(){
  const sel=$("fDist");
  DISTRICTS.forEach(([id,name])=>{const o=document.createElement("option");o.value=id;o.textContent=name;sel.appendChild(o);});
})();

/* ---------- шаг 2: фото ---------- */
function renderPhotos(){
  const grid=$("photoGrid");grid.innerHTML="";
  W.photos.forEach((src,i)=>{
    const cell=document.createElement("div");
    cell.className="photo-slot"+(i===0?" cover":"");
    cell.innerHTML=`<img src="${src}"><span class="x" data-i="${i}">✕</span>`;
    grid.appendChild(cell);
  });
  if(W.photos.length<5){
    const add=document.createElement("label");
    add.className="photo-slot photo-add";
    add.innerHTML=`<svg class="ic" style="width:22px;height:22px" viewBox="0 0 24 24"><use href="#ic-camera"/></svg><input type="file" accept="image/*" id="fileInput">`;
    grid.appendChild(add);
  }
}
$("photoGrid").addEventListener("click",e=>{
  const x=e.target.closest(".x");if(!x)return;hap();
  W.photos.splice(+x.dataset.i,1);renderPhotos();
});
$("photoGrid").addEventListener("change",e=>{
  if(e.target.id!=="fileInput")return;
  const file=e.target.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=()=>{W.photos.push(reader.result);renderPhotos();$("err2").classList.remove("show");};
  reader.readAsDataURL(file);
});

/* ---------- шаг 3: тихие часы ---------- */
function renderWeekdays(){
  const box=$("wdRow");box.innerHTML="";
  WDS.forEach((label,i)=>{
    const b=document.createElement("button");
    b.className="wd-chip"+(W.weekdays.includes(i)?" on":"");
    b.textContent=label;
    b.onclick=()=>{hap();
      const idx=W.weekdays.indexOf(i);
      if(idx>=0)W.weekdays.splice(idx,1);else W.weekdays.push(i);
      renderWeekdays();};
    box.appendChild(b);
  });
}
function renderSlots(){
  const box=$("slotList");box.innerHTML="";
  W.slots.forEach((sl,i)=>{
    const row=document.createElement("div");row.className="slot-row";
    const hourOpts=Array.from({length:12},(_,k)=>k+10).map(h=>`<option value="${h}"${h===sl.hour?" selected":""}>${h}:00</option>`).join("");
    const discOpts=[20,25,30,35,40,45,50].map(d=>`<option value="${d}"${d===sl.discount?" selected":""}>−${d}%</option>`).join("");
    row.innerHTML=`<select data-i="${i}" data-f="hour">${hourOpts}</select>
      <select data-i="${i}" data-f="discount">${discOpts}</select>
      <span class="rm" data-i="${i}">✕</span>`;
    box.appendChild(row);
  });
}
$("slotList").addEventListener("change",e=>{
  const sel=e.target;if(sel.tagName!=="SELECT")return;
  W.slots[+sel.dataset.i][sel.dataset.f]=+sel.value;
});
$("slotList").addEventListener("click",e=>{
  const rm=e.target.closest(".rm");if(!rm)return;hap();
  W.slots.splice(+rm.dataset.i,1);renderSlots();
});
$("addSlotBtn").onclick=()=>{hap();W.slots.push({hour:15,discount:30});renderSlots();};

/* ---------- навигация мастера ---------- */
function collectStep1(){
  W.name=$("fName").value.trim();W.cat=$("fCat").value;W.district=$("fDist").value;
  W.address=$("fAddr").value.trim();W.phone=$("fPhone").value.trim();W.url=$("fUrl").value.trim();
}
$("wzNext").onclick=async ()=>{
  hap();
  if(screen==="step1"){
    collectStep1();
    $("err1").classList.remove("show");
    if(W.name.length<2||W.address.length<4||W.phone.length<5){
      $("err1").classList.add("show");return;
    }
    try{
      if(!W.id){
        const r=await api("/api/cab/venues",{method:"POST",body:JSON.stringify(
          {name:W.name,cat:W.cat,district:W.district,address:W.address,phone:W.phone,url:W.url})});
        W.id=r.venue_id;
      } else {
        await api(`/api/cab/venues/${W.id}`,{method:"PATCH",body:JSON.stringify(
          {name:W.name,cat:W.cat,district:W.district,address:W.address,phone:W.phone,url:W.url})});
      }
      go("step2");
    }catch(err){toast(err.message,true);}
    return;
  }
  if(screen==="step2"){
    $("err2").classList.remove("show");
    if(!W.photos.length){$("err2").classList.add("show");return;}
    try{
      // Грузим все снимки, а не только первый, и не отправляем повторно те,
      // что уже ушли на сервер — иначе шаг назад и вперёд плодил бы дубли.
      for(const src of W.photos){
        if(W.uploaded.indexOf(src) >= 0) continue;
        await api(`/api/cab/venues/${W.id}/photos`,{method:"POST",body:JSON.stringify({data_url:src})});
        W.uploaded.push(src);
      }
      go("step3");
    }catch(err){toast(err.message,true);}
    return;
  }
  if(screen==="step3"){
    $("err3").classList.remove("show");
    if(!W.weekdays.length||!W.slots.length){$("err3").classList.add("show");return;}
    try{
      await api(`/api/cab/venues/${W.id}/quiet-hours`,{method:"PUT",body:JSON.stringify(
        {weekdays:W.weekdays,slots:W.slots.map(s=>({hour:s.hour,discount:s.discount,capacity:4}))})});
      renderReview();
      go("step4");
    }catch(err){toast(err.message,true);}
    return;
  }
  if(screen==="step4"){
    try{
      await api(`/api/cab/venues/${W.id}/submit`,{method:"POST"});
      toast("Отправлено на модерацию");
      await refreshList();
      openStatus(W.id);
    }catch(err){toast(err.message,true);}
    return;
  }
};
$("wzBack").onclick=()=>{hap();
  const order=["step1","step2","step3","step4"];
  const idx=order.indexOf(screen);
  if(idx>0) go(order[idx-1]); else go("list");
};

function renderReview(){
  $("rvName").textContent=W.name;
  $("rvCat").textContent=CAT_LABEL[W.cat];
  $("rvDist").textContent=DN[W.district]||W.district;
  $("rvAddr").textContent=W.address;
  $("rvPhone").textContent=W.phone||"—";
  $("rvPhotos").textContent=`${W.photos.length} шт.`;
  $("rvHours").textContent=`${W.weekdays.length} дн. × ${W.slots.length} час.`;
}

/* ---------- экран статуса ---------- */
async function openStatus(id){
  const v = await api(`/api/cab/venues/${id}`);
  $("stName").textContent=v.name;
  $("stSub").textContent=`${v.cat_label||CAT_LABEL[v.cat]} · ${DN[v.district]||v.district}`;
  const body=$("statusBody");
  let card="";
  if(v.status==="moderation"){
    card=`<div class="status-card wait"><div class="si">🕓</div><b>На модерации</b>
      <span>Проверяем адрес, фото и часы. Обычно это занимает до 24 часов — заведение появится в ленте сразу после одобрения.</span></div>`;
  } else if(v.status==="active"){
    card=`<div class="status-card active"><div class="si">✅</div><b>Опубликовано</b>
      <span>Заведение видно гостям в ленте «Тихого Часа». Тихие часы можно менять в любой момент — просто отредактируйте карточку.</span></div>`;
  } else {
    card=`<div class="status-card draft"><div class="si">✏️</div><b>Черновик</b>
      <span>Заявка ещё не отправлена или была возвращена на доработку. Проверьте данные и отправьте снова.</span></div>`;
  }
  body.innerHTML=card+`
    <div class="review-card">
      <b>${v.name}</b>
      <div class="review-line"><span>Адрес</span><b>${v.address||"—"}</b></div>
      <div class="review-line"><span>Телефон</span><b>${v.phone||"—"}</b></div>
      <div class="review-line"><span>Фото</span><b>${(v.photos||[]).length} шт.</b></div>
      <div class="review-line"><span>Тихие окна</span><b>${(v.quiet_windows||[]).length} шт.</b></div>
    </div>`;
  go("status");
}

/* ---------- toast ---------- */
let tt;function toast(m,isErr){const t=$("toast");t.textContent=m;t.className="toast show"+(isErr?" err":"");
 clearTimeout(tt);tt=setTimeout(()=>t.classList.remove("show"),2600);}

/* ---------- clock ---------- */
function clock(){$("clock").textContent=new Date().toLocaleTimeString("ru-RU",{hour:"2-digit",minute:"2-digit"});}
clock();setInterval(clock,30000);

/* ---------- init ---------- */
renderPhotos();renderWeekdays();renderSlots();
boot();
</script>
