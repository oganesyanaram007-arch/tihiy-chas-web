          <div class="review-line"><span>Район</span><b id="rvDist">—</b></div>
          <div class="review-line"><span>Адрес</span><b id="rvAddr">—</b></div>
          <div class="review-line"><span>Телефон</span><b id="rvPhone">—</b></div>
