      <!-- ===== ШАГ 4: ПРОВЕРКА И ОТПРАВКА ===== -->
      <section class="screen" id="scr-step4">
        <div class="wizard-head">
          <div class="wz-title">Проверьте и отправьте</div>
          <div class="wz-sub">Шаг 4 из 4 · модератор ответит в течение 24 часов</div>
          <div class="wz-bar"><i class="done"></i><i class="done"></i><i class="done"></i><i class="done"></i></div>
