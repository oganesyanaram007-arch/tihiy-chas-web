<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Тихий Час — Кабинет партнёра</title>
<script>window.TG_SDK={done:false};</script>
<script async src="https://telegram.org/js/telegram-web-app.js"
        onload="window.TG_SDK.done=true" onerror="window.TG_SDK.done=true"></script>
<!-- Google Fonts убраны: сервис недоступен в России, браузер ждал
     таймаута с пустым экраном. Системные шрифты рисуются сразу. -->
<style>
:root{
  --espresso:#191410; --espresso-2:#221A14; --oat:#F4EFE6; --porcelain:#FBF7EF;
  --honey:#DFA63C; --honey-d:#B9822A; --dusk:#26324F;
  --ink:#20180F; --ink-soft:#6E6456; --cream-soft:#DBD2C1; --cream-dim:#A99E8B;
  --line-lt:#E7DECB; --line-dk:#3A2E23; --ok:#2E9E6B; --err:#C2542F;
  --disp:'New York','Iowan Old Style',Georgia,'Times New Roman',serif;
  --sans:-apple-system,BlinkMacSystemFont,'SF Pro Text',system-ui,'Segoe UI','Roboto',sans-serif;
  --mono:ui-monospace,'SF Mono','SFMono-Regular','Menlo',monospace;
  color-scheme:light only;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;font-synthesis:none}
button{font-family:var(--sans);cursor:pointer;border:none;background:none}
.ic{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}
body{font-family:var(--sans);background:radial-gradient(1000px 620px at 72% -6%,#2A2016,#0E0A07 66%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:26px 14px;color:var(--ink)}
.stage{display:flex;gap:36px;align-items:center;flex-wrap:wrap;justify-content:center}
.side{max-width:250px;color:var(--cream-soft);font-size:13.5px;line-height:1.62}
.side b{color:#FBF7EF;font-family:var(--disp);font-weight:700;font-size:17px;display:block;margin-bottom:9px}
.side .tip{margin-top:14px;padding:13px 15px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:14px}
.side .tip b{font-family:var(--sans);font-size:12.5px;color:var(--honey);margin-bottom:5px}
@media(max-width:860px){.side{display:none}body{padding:0}}

.phone{width:393px;max-width:100vw;height:812px;max-height:100vh;background:#000;border-radius:54px;padding:10px;box-shadow:0 44px 100px rgba(0,0,0,.6);position:relative}
@media(max-width:430px){.phone{border-radius:0;padding:0;height:100vh;height:100dvh}}
.screen-wrap{background:var(--oat);border-radius:44px;height:100%;overflow:hidden;display:flex;flex-direction:column;position:relative}
@media(max-width:430px){.screen-wrap{border-radius:0}}

.statusbar{height:34px;display:flex;justify-content:space-between;align-items:center;padding:0 24px;font-family:var(--sans);font-size:13px;font-weight:700;background:var(--espresso);color:#FBF7EF;flex:none}
.tgbar{height:50px;background:var(--espresso);color:#FBF7EF;display:flex;align-items:center;padding:0 10px;flex:none;border-bottom:1px solid var(--line-dk)}
.tg-left{color:var(--cream-soft);font-size:14.5px;padding:8px 10px;min-width:60px;text-align:left}
.tg-title{flex:1;display:flex;align-items:center;justify-content:center;gap:9px}
.tg-title .ic{width:20px;height:20px;stroke:var(--honey)}
.tg-title b{font-family:var(--disp);font-weight:700;font-size:15.5px}
.tg-menu{min-width:60px}

.app{flex:1;overflow-y:auto;overscroll-behavior:contain;padding-bottom:118px;scrollbar-width:none}
.app::-webkit-scrollbar{display:none}
.screen{display:none;animation:fade .2s ease}
.screen.on{display:block}
@keyframes fade{from{opacity:.3;transform:translateY(6px)}to{opacity:1;transform:none}}

/* ---- вход ---- */
.gate{padding:60px 26px;text-align:center}
.gate-ic{width:64px;height:64px;border-radius:20px;background:var(--espresso);color:var(--honey);display:grid;place-items:center;margin:0 auto 20px}
.gate-ic .ic{width:32px;height:32px}
.gate h1{font-family:var(--disp);font-weight:700;font-size:24px;color:var(--ink)}
.gate p{font-size:13.5px;color:var(--ink-soft);margin:10px 0 26px;line-height:1.55}
.gate .status{font-family:var(--mono);font-size:11.5px;color:var(--honey-d);margin-top:16px}

/* ---- прогресс мастера ---- */
.wizard-head{padding:16px 18px 4px}
.wz-title{font-family:var(--disp);font-weight:700;font-size:20px;color:var(--ink)}
.wz-sub{font-size:12.5px;color:var(--ink-soft);margin-top:3px}
.wz-bar{display:flex;gap:5px;margin-top:14px}
.wz-bar i{flex:1;height:4px;border-radius:99px;background:var(--line-lt)}
.wz-bar i.done{background:var(--honey)}

.fld{margin:0 18px 16px}
.fld label{display:block;font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px}
.fld input,.fld select,.fld textarea{width:100%;font-family:var(--sans);font-size:14.5px;color:var(--ink);background:var(--porcelain);border:1.5px solid var(--line-lt);border-radius:12px;padding:12px 13px}
.fld textarea{resize:none;min-height:70px}
.fld-row{display:flex;gap:10px;margin:0 18px 16px}
.fld-row .fld{margin:0;flex:1}
.fld-err{color:var(--err);font-size:11.5px;margin:-10px 18px 14px;display:none}
.fld-err.show{display:block}

/* ---- фото ---- */
.photos{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:0 18px 16px}
.photo-slot{aspect-ratio:1;border-radius:13px;border:1.5px dashed var(--line-lt);background:var(--porcelain);display:grid;place-items:center;color:var(--ink-soft);position:relative;overflow:hidden}
.photo-slot img{width:100%;height:100%;object-fit:cover}
.photo-slot .x{position:absolute;top:5px;right:5px;width:20px;height:20px;border-radius:50%;background:rgba(25,18,14,.6);color:#fff;display:grid;place-items:center;font-size:11px}
.photo-slot.cover::after{content:"обложка";position:absolute;bottom:4px;left:4px;right:4px;font-family:var(--mono);font-size:8px;text-align:center;background:rgba(25,18,14,.6);color:var(--honey);border-radius:6px;padding:2px}
.photo-add{border:none;cursor:pointer}
input[type=file]{display:none}

/* ---- тихие часы ---- */
.wd-row{display:flex;gap:6px;margin:0 18px 18px;flex-wrap:wrap}
.wd-chip{flex:1;min-width:38px;padding:10px 0;text-align:center;border:1.5px solid var(--line-lt);border-radius:10px;background:var(--porcelain);font-family:var(--mono);font-size:11px;font-weight:700;color:var(--ink-soft)}
.wd-chip.on{background:var(--espresso);border-color:var(--espresso);color:var(--honey)}
.slot-list{margin:0 18px 12px;display:flex;flex-direction:column;gap:9px}
.slot-row{display:flex;gap:8px;align-items:center;background:var(--porcelain);border:1.5px solid var(--line-lt);border-radius:12px;padding:9px 11px}
.slot-row select{flex:1;font-family:var(--mono);font-size:13px;background:none;border:none;color:var(--ink)}
.slot-row .rm{color:var(--err);font-size:16px;padding:0 4px}
.add-slot{margin:0 18px 16px;display:flex;align-items:center;justify-content:center;gap:7px;padding:11px;border:1.5px dashed var(--line-lt);border-radius:12px;color:var(--honey-d);font-size:13px;font-weight:700}

/* ---- итог/статус ---- */
.review-card{margin:0 18px 14px;background:var(--porcelain);border:1px solid var(--line-lt);border-radius:14px;padding:14px 15px}
.review-card b{font-family:var(--disp);font-size:16px;display:block;margin-bottom:6px}
.review-line{display:flex;justify-content:space-between;font-size:12.5px;color:var(--ink-soft);padding:5px 0;border-top:1px solid var(--line-lt)}
.review-line:first-of-type{border-top:none}
.review-line b{font-family:var(--sans);font-weight:600;color:var(--ink)}

.status-card{margin:16px 18px;padding:18px;border-radius:16px;text-align:center}
.status-card.wait{background:#FBEFD6;border:1px solid #EBD9B4}
.status-card.active{background:#EAF3EC;border:1px solid #C3DECA}
.status-card.draft{background:#FBEAE6;border:1px solid #E8C4BB}
.status-card .si{font-size:26px;margin-bottom:6px}
.status-card b{font-family:var(--disp);font-size:16.5px;display:block}
.status-card span{font-size:12.5px;color:var(--ink-soft);display:block;margin-top:4px;line-height:1.5}

.venue-row{margin:0 18px 10px;background:var(--porcelain);border:1px solid var(--line-lt);border-radius:14px;padding:13px 14px;display:flex;align-items:center;gap:11px}
.venue-row .vi{width:40px;height:40px;border-radius:11px;background:var(--espresso);color:var(--honey);display:grid;place-items:center;flex:none}
.venue-row b{font-size:14px;display:block}
.venue-row span{font-size:11.5px;color:var(--ink-soft)}
.badge{margin-left:auto;font-family:var(--mono);font-size:9.5px;font-weight:700;padding:5px 9px;border-radius:999px;white-space:nowrap}
.badge.draft{background:#EFE6DD;color:var(--ink-soft)}
.badge.moderation{background:#FBEFD6;color:var(--honey-d)}
.badge.active{background:#EAF3EC;color:var(--ok)}

.sect-cap{padding:14px 18px 8px;font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft)}
.fab{position:absolute;left:14px;right:14px;bottom:94px;height:50px;border-radius:14px;background:var(--honey);color:var(--espresso);font-size:14.5px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:8px;z-index:15}
.fab:active{transform:scale(.985)}
.wz-actions{position:absolute;left:14px;right:14px;bottom:24px;display:flex;gap:10px;z-index:20}
.wz-actions button{flex:1;height:48px;border-radius:14px;font-size:14px;font-weight:700}
.btn-ghost{background:var(--porcelain);border:1.5px solid var(--line-lt);color:var(--ink)}
.btn-primary{background:var(--espresso);color:#FBF7EF}
.btn-primary:disabled{opacity:.5}

.toast{position:absolute;left:50%;bottom:150px;transform:translateX(-50%) translateY(8px);background:var(--espresso);color:#FBF7EF;font-size:12.5px;font-weight:600;border-radius:12px;padding:10px 16px;opacity:0;pointer-events:none;transition:.25s;z-index:60;white-space:nowrap;box-shadow:0 14px 34px rgba(0,0,0,.4)}
.toast.show{opacity:1;transform:translateX(-50%)}
.toast.err{background:var(--err)}

.tabbar{position:absolute;left:0;right:0;bottom:0;height:76px;background:var(--espresso);border-top:1px solid var(--line-dk);display:flex;padding:8px 6px 20px;border-radius:0 0 44px 44px}
@media(max-width:430px){.tabbar{border-radius:0}}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;font-family:var(--mono);font-size:9px;font-weight:700;color:var(--cream-dim)}
.tab .ic{width:20px;height:20px}
.tab.sel{color:var(--honey)}
</style>
</head>
<body>

